# --- FortiGate ---
# IP/hostname da interface de gerência do FortiGate (com porta se não for 443, ex: 192.168.1.99:8443)
FGT_HOST=192.168.1.99
# Token do admin "REST API" gerado por: execute api-user generate-key acessowifi
# (a conexão é por token; o painel não usa usuário/senha de admin do FortiGate)
FGT_TOKEN=coloque_o_token_aqui
FGT_VDOM=root
# true = valida o certificado | false = aceita self-signed | ou caminho do CA: /etc/acessowifi/fgt-ca.pem
FGT_VERIFY_SSL=false
# Grupo(s) guest onde o painel cadastra usuários (separados por vírgula). Vazio = todos os grupos guest.
FGT_GUEST_GROUPS=WiFi-Cadastrados
# Validade máxima permitida no cadastro, em dias
MAX_VALIDITY_DAYS=365
# Grupo de endereços usado em "Exempt sources" do captive portal (aparelhos "permitir sempre")
FGT_MAC_GROUP=WiFi-MAC-Liberados
# O fuso do servidor deve ser o mesmo do FortiGate (a validade é gravada na hora local)
TZ=America/Sao_Paulo

# --- Login da página ---
APP_USER=admin
# Gere com: python3 -c "from werkzeug.security import generate_password_hash as g; print(g(input('Senha: ')))"
APP_PASSWORD_HASH=
# Gere com: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
# Deixe true quando estiver atrás de HTTPS; false só para testar em http://localhost
COOKIE_SECURE=true

# Endereço em que o painel escuta. Com nginx na frente: 127.0.0.1:8080; sem nginx: 0.0.0.0:8080
BIND=127.0.0.1:8080

# 1 = usa dados fictícios (não conecta no FortiGate)
DEMO_MODE=0
# Porta usada só quando roda com "python app.py" (testes)
PORT=8080
