[Unit]
Description=Painel Acesso Wi-Fi (FortiGate)
After=network-online.target

[Service]
User=acessowifi
Group=acessowifi
WorkingDirectory=/opt/acessowifi
EnvironmentFile=/opt/acessowifi/.env
ExecStart=/opt/acessowifi/.venv/bin/gunicorn -w 2 -b 127.0.0.1:8080 app:app
Restart=on-failure
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
