[Unit]
Description=Painel Acesso Wi-Fi (FortiGate)
After=network-online.target
Wants=network-online.target

[Service]
User=acessowifi
Group=acessowifi
WorkingDirectory=/opt/acessowifi
EnvironmentFile=/opt/acessowifi/.env
ExecStart=/opt/acessowifi/.venv/bin/gunicorn -w 2 -b ${BIND} --access-logfile - app:app
Restart=on-failure
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
# Única pasta em que o painel escreve: pedidos de atualização (o "-" tolera a pasta ausente)
ReadWritePaths=-/var/lib/acessowifi-ctl

[Install]
WantedBy=multi-user.target
